CompileFlags:
  # GCC-only flags Clang does not understand (-mcpu=cell is fatal for Clang).
  Remove: [-mcpu=*, -fmodulo-sched]
  Add:
    # PS3 data model: 32-bit long, pointers and size_t on a 64-bit PPU.
    # Clang has no such mode for powerpc64, but 32-bit PowerPC has the same sizes.
    - -m32
    - -maltivec       # vector types, as -mcpu=cell enables in GCC
    - -fsigned-char   # plain char is signed in PS3DK
    - -fshort-wchar   # wchar_t is 16 bits
    # Macros the PS3 GCC predefines that the SDK headers check.
    - -D__powerpc64__
    - -D__PPU__
    - -D__lv2ppu__
    - -D__CELLOS_LV2__

Diagnostics:
  # SDK headers mark pointers with ATTRIBUTE_PRXPTR = __attribute__((mode(SI))),
  # a GCC way of forcing 32-bit pointers. Clang rejects it on pointers; with
  # -m32 pointers are 32-bit anyway, so ignoring it changes nothing.
  Suppress: [mode_not_primitive]

Documentation:
  CommentFormat: Doxygen